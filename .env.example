# Where the index and uploaded docs live. Defaults are fine for running
# locally. In Docker, point these at your mounted volume so data survives
# container rebuilds — see DEPLOY_DOCKER_BEDROCK.md.
# INDEX_PATH=/app/data/index.pkl
# DOCS_FOLDER=/app/data/sample_docs

# Which generation backend to use: "gemini" or "bedrock"
GENERATION_BACKEND=gemini

# --- Gemini backend ---
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- Knowledge Bases backend (api_kb.py only) ---
# For local testing against real AWS resources. On App Runner these are
# set as real environment variables instead (see DEPLOY_APPRUNNER_KB.md).
# KNOWLEDGE_BASE_ID=ABCD1234EF
# DATA_SOURCE_ID=XXXXXXXXXX
# S3_BUCKET_NAME=rag-project-docs-yourname
# GEMINI_API_KEY_PARAM=/rag-project/gemini-api-key
# No AWS access keys needed here when running on EC2 with an IAM role
# attached (recommended — see DEPLOY_DOCKER_BEDROCK.md). For local testing
# without an IAM role, set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here
# or via `aws configure` instead.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
